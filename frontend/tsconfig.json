{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next",
      },
    ],
    "paths": {
      "@store/*": ["./store/*"],
      "@components/*": ["./ui/components/*"],
      "@static/*": ["./static/*"],
      "@pages/*": ["./ui/pages/*"],
      "@interfaces/*": ["./interfaces*"],
      "@api/*": ["./api/*"],
      "@libs/*": ["./libs/*"],
      "@common/*": ["./common/*"],
      "@styles/*": ["./styles/*"],
    },
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
  ],
  "exclude": ["node_modules"],
}
